# Set these in your shell or enterprise secret manager. This file is not loaded automatically.
DS_LLM_BASE_URL=https://your-approved-inference-host/v1
DS_LLM_MODEL=your-model-or-deployment-name
DS_LLM_API_KEY=your-api-key
# ODBC Driver 18 for SQL Server must be installed separately.
# Use an account with SELECT access only on approved tables/views.
DS_SQLSERVER_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server,1433;Database=your-database;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly;
